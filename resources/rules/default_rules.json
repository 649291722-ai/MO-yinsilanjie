        {
          "id": "private_ip",
          "type": "regex",
          "pattern": "(\\d{1,3}\\.){3}\\d{1,3}(:\\d{1,5})?",
          "reason": "IP 地址"
        },
        {
          "id": "internal_address",
          "type": "regex",
          "pattern": "(127\\.0\\.0\\.1|localhost|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})",
          "reason": "内网地址"
        },
        {
          "id": "local_path",
          "type": "regex",
          "pattern": "(/sdcard/|/storage/|/data/|/system/|/etc/|/root/|/home/[A-Za-z0-9_-]+/|C:\\\\Users\\\\|D:\\\\Users\\\\)",
          "reason": "本地文件路径"
        },
        {
          "id": "api_key",
          "type": "regex",
          "pattern": "(sk-[A-Za-z0-9_-]{16,}|Bearer\\s+[A-Za-z0-9._-]{16,}|api[_-]?key[\"'\\s:=]{1,4}[A-Za-z0-9_-]{16,}|secret[\"'\\s:=]{1,4}[A-Za-z0-9_-]{16,})",
          "reason": "API 密钥"
        },
        {
          "id": "email_address",
          "type": "regex",
          "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
          "reason": "邮箱地址"
        },
        {
          "id": "server_url",
          "type": "regex",
          "pattern": "(wss?://|https?://)(\\d{1,3}\\.){3}\\d{1,3}(:\\d{1,5})?",
          "reason": "IP 直连服务器地址"
        },
        {
          "id": "id_card",
          "type": "regex",
          "pattern": "(?<![0-9])[0-9]{17}[0-9Xx](?![0-9])",
          "reason": "身份证号"
        },
        {
          "id": "phone_number",
          "type": "regex",
          "pattern": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
          "reason": "手机号"
        },
        {
          "id": "private_domain",
          "type": "regex",
          "pattern": "((https?://)?([A-Za-z0-9-]+\\.)*your-domain\\.com(:\\d+)?)",
          "reason": "私有服务域名（本地基础设施地址，禁止外泄）"
        }
      ],
      "soft_rules": []
    },
    "internal": {
      "hard_rules": [
        {
          "id": "local_path",
          "type": "regex",
          "pattern": "(/sdcard/|/storage/|/data/|/system/|/etc/|/root/|/home/[A-Za-z0-9_-]+/|C:\\\\Users\\\\|D:\\\\Users\\\\)",
          "reason": "本地文件路径"
        },
        {
          "id": "phone_number",
          "type": "regex",
          "pattern": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
